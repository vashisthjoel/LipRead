# ==============================================================================
# LipRead — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your local configuration values.
# NEVER commit the active '.env' file or real credentials to version control.
# ==============================================================================

# Data & Model Checkpoint Paths
LIPREAD_DATA_ROOT=./data
LIPREAD_CHECKPOINT_PATH=./checkpoints/best_model.pt

# FastAPI & Streamlit Service Settings
LIPREAD_API_URL=http://localhost:8000
LIPREAD_API_HOST=0.0.0.0
LIPREAD_API_PORT=8000

# GenAI Contextual Post-Processing Configuration (Optional)
GENAI_ENABLED=false
LIPREAD_LLM_PROVIDER=mock
LIPREAD_LLM_MODEL=gpt-4o-mini
LIPREAD_LLM_API_KEY=
LIPREAD_LLM_API_BASE=
LIPREAD_LLM_TEMPERATURE=0.0
LIPREAD_LLM_MAX_TOKENS=128
LIPREAD_LLM_TIMEOUT=15.0
